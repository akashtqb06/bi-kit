# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# build
/build
dist/
.next/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/

# env files
.env*
.env.local
.env*.local
!.env.example
!.env.production.example
.env.production

# backups
/backups/*
!/backups/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local databases, uploads, csv, and avatars
data/*.db
data/*.db-wal
data/*.db-shm
data/uploads
data/csv
data/csv-sources
data/avatars
/data/*
!/data/.gitkeep
