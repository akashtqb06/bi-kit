{
  "$schema": "https://unpkg.com/knip@5/overview.json",
  "entry": [
    "src/app/**/{page,layout,route,loading,error,not-found,template,default}.{ts,tsx,js,jsx}",
    "scripts/**/*.{ts,js,mjs}",
    "vitest.empty.js"
  ],
  "project": [
    "src/**/*.{ts,tsx,js,jsx}",
    "scripts/**/*.{ts,js,mjs}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "*.{ts,js,mjs}"
  ],
  "ignore": [
    "src/components/ui/**",
    "components/ui/**",
    "src/lib/db/migrations/**"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "@tailwindcss/postcss",
    "tw-animate-css",
    "shadcn",
    "postcss",
    "drizzle-kit",
    "tsx",
    "better-sqlite3",
    "react-day-picker"
  ],
  "ignoreBinaries": [
    "esbuild"
  ]
}

