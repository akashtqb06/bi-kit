{
  "name": "bi-kit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:scripts": "esbuild scripts/prod-migrate.ts --bundle --platform=node --target=node22 --outfile=dist/migrate.cjs --external:pg-native && esbuild scripts/prod-bootstrap.ts --bundle --platform=node --target=node22 --outfile=dist/bootstrap.cjs --external:pg-native && esbuild scripts/prod-validate-env.ts --bundle --platform=node --target=node22 --outfile=dist/validate-env.cjs --external:pg-native",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_INTEGRATION=1 vitest run src/lib/connectors/integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:create-local": "tsx scripts/create-local-db.ts",
    "db:migrate": "tsx --conditions=react-server src/lib/db/migrate.ts",
    "db:migrate:connectors": "tsx --conditions=react-server scripts/migrate-connectors.ts",
    "db:seed:users": "tsx --conditions=react-server scripts/seed/users.ts",
    "db:seed:demo": "tsx --conditions=react-server scripts/seed/demo-data.ts",
    "db:seed:external": "tsx --conditions=react-server scripts/seed/external.ts",
    "db:seed:workbook": "tsx --conditions=react-server scripts/seed/sample-workbook.ts",
    "db:seed:finance": "tsx --conditions=react-server scripts/seed/finance.ts",
    "db:seed:categories": "tsx --conditions=react-server scripts/seed/system-categories.ts",
    "finance:fixtures": "tsx --conditions=react-server scripts/seed/finance-fixtures.ts",
    "finance:init": "tsx --conditions=react-server scripts/setup-personal-finance.ts",
    "finance:verify": "tsx --conditions=react-server scripts/finance-verify.ts",
    "finance:purge-demo": "tsx --conditions=react-server scripts/finance-purge-demo.ts",
    "finance:coverage": "tsx --conditions=react-server scripts/finance-coverage.ts",
    "db:seed": "pnpm run db:seed:users && pnpm run db:seed:demo && pnpm run db:seed:workbook",
    "db:reset": "tsx --conditions=react-server scripts/seed/reset.ts",
    "db:studio": "drizzle-kit studio",
    "db:clean-tests": "tsx --conditions=react-server scripts/seed/clean-tests.ts",
    "user:reset-password": "tsx --conditions=react-server scripts/reset-password.ts",
    "setup": "pnpm install && pnpm run db:migrate && pnpm run db:seed"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-table": "^9.3.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.57.0",
    "mongodb": "^7.7.0",
    "mssql": "^12.7.13",
    "mysql2": "^3.24.6",
    "nanoid": "^6.0.2",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-grid-layout": "^2.3.0",
    "react-hook-form": "^7.90.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "knip": "^6.41.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.20.0"
}
