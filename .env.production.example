# ==============================================================================
# BI Kit Production Self-Hosted Environment Configuration
# Generate this file automatically using: ./scripts/init-env.sh
# ==============================================================================

# Database Credentials & Connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_DB=bikit_prod
DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@db:5432/bikit_prod

# Postgres Client Defaults (used by backup and restore scripts)
PGHOST=db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=${POSTGRES_PASSWORD}
PGDATABASE=bikit_prod

# Application Host & Port Configuration
APP_PORT=3100
APP_URL=http://localhost:3100
# Comma-separated list of additional trusted origins (e.g. for LAN access)
APP_EXTRA_ORIGINS=https://finance.local
APP_TIMEZONE=Asia/Kolkata
DATA_DIR=/app/data

# Security Secrets (Must be generated with cryptographic randomness)
# 32+ bytes base64-encoded secret key for encrypting data connector credentials
CONNECTOR_SECRET_KEY=replace-with-32-byte-base64-secret-key
# Secret token for authenticating internal cron requests (/api/cron/*)
CRON_SECRET=replace-with-random-cron-secret

# User Registration Policy (default: closed for self-hosted instances)
ALLOW_REGISTRATION=false

# First-Run Bootstrap Admin (used ONLY once when initializing an empty database)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-admin-initial-password
# Do not seed demo dummy data in production unless explicitly set to true
SEED_DEMO=false

# Backup Configuration
# Exclude re-syncable connector staging schemas from dumps
BACKUP_EXCLUDE_SCHEMAS=store_*
# Optional host path or rsync target directory for offsite replication
BACKUP_SYNC_DIR=

# LAN Profile Settings (when using --profile lan)
LAN_HOSTNAME=finance.local

# Finance Module Feature Flags (comma-separated list: overview,transactions,accounts,setup,budgets,recurring,import)
FINANCE_FEATURES=overview,transactions,accounts,setup,recurring,import


