FROM alpine:3.20

RUN apk add --no-cache curl tzdata ca-certificates bash

# Install supercronic for linux/amd64 or linux/arm64
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "$ARCH" in \
        x86_64) SUPERCRONIC_ARCH="supercronic-linux-amd64" ;; \
        aarch64|arm64) SUPERCRONIC_ARCH="supercronic-linux-arm64" ;; \
        *) echo "Unsupported architecture: $ARCH" && exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/aptible/supercronic/releases/download/v0.2.33/${SUPERCRONIC_ARCH}" -o /usr/local/bin/supercronic; \
    chmod +x /usr/local/bin/supercronic

WORKDIR /app
COPY docker/crontab /etc/crontab

CMD ["/usr/local/bin/supercronic", "-passthrough-logs", "/etc/crontab"]

