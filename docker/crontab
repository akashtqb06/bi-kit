# BI Kit Automated Scheduled Tasks
# Daily recurring transaction generation (02:00)
0 2 * * * curl -fsS -X POST -H "Authorization: Bearer ${CRON_SECRET}" http://app:3000/api/cron/recurring

# Daily valuation snapshot capture (02:15)
15 2 * * * curl -fsS -X POST -H "Authorization: Bearer ${CRON_SECRET}" http://app:3000/api/cron/valuations

# Daily expired audit log purge (02:30)
30 2 * * * curl -fsS -X POST -H "Authorization: Bearer ${CRON_SECRET}" http://app:3000/api/cron/audit-purge

# Daily data store sync (03:00)
0 3 * * * curl -fsS -X POST -H "Authorization: Bearer ${CRON_SECRET}" http://app:3000/api/cron/data-store

