# ==============================================================================
# BI Kit Environment Variables Example
# ==============================================================================

# Directory where application databases, CSV imports, avatars, and uploads are stored.
# Defaults to ./data in the project root if unset.
DATA_DIR=data

# Path to the primary application SQLite database file.
# Defaults to ${DATA_DIR}/app.db if unset.
APP_DB_PATH=data/app.db

# ------------------------------------------------------------------------------
# Demo Seed Credentials
# ------------------------------------------------------------------------------
# Demo administrator account credentials for database seeding scripts.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Demo member account credentials for database seeding scripts.
SEED_DEMO_USER_EMAIL=member@example.com
SEED_DEMO_USER_PASSWORD=ChangeMe123!

# Note: In production (NODE_ENV=production), seed scripts will refuse to run with
# the default "ChangeMe123!" passwords. Explicit passwords must be configured.

# ------------------------------------------------------------------------------
# Server and Runtime Options
# ------------------------------------------------------------------------------
# NODE_ENV=development
# PORT=3000

# ------------------------------------------------------------------------------
# Connectors Framework Options
# ------------------------------------------------------------------------------
# 32-byte base64-encoded secret key for encrypting data source secrets.
# Required in production. In development, auto-generated in data/.dev-secret-key if unset.
CONNECTOR_SECRET_KEY=

# Network security policy for remote database connections ('allow-private' | 'public-only')
CONNECTOR_NETWORK_POLICY=allow-private

# Optional comma-separated hosts or CIDR blocks for connector network guard
# CONNECTOR_HOST_ALLOWLIST=
# CONNECTOR_HOST_DENYLIST=

# Concurrency and cache options
# CONNECTOR_MAX_CONCURRENCY=4
# CONNECTOR_MAX_QUEUE=50
# CONNECTOR_CACHE_TTL_MS=60000

# File connector options
FILE_MAX_MB=100
ALLOW_LOCAL_SQLITE_PATHS=false
LOCAL_SQLITE_ROOT=data/local
EXCEL_MAX_ROWS=500000

# External database seed URLs (for pnpm db:seed:external and pnpm test:integration)
SEED_EXTERNAL=false
SEED_PG_URL=postgres://bikit_admin:AdminPassword123!@localhost:5433/bikit_dev
SEED_MYSQL_URL=mysql://bikit_admin:AdminPassword123!@localhost:3307/bikit_dev
SEED_MSSQL_URL=sqlserver://sa:Password123!@localhost:1434?database=bikit_dev&trustServerCertificate=true
SEED_MONGO_URL=mongodb://mongoadmin:bi_password_123!@localhost:27018/bikit_dev?authSource=admin


